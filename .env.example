# ===== 后端（ASHARE_ 前缀，见 backend/app/core/config.py）=====
# 数据源链：主源 + 备源（tencent | sina | eastmoney | mock；mock 只能单独使用）
ASHARE_DATA_PROVIDER=tencent
ASHARE_PROVIDER_FALLBACKS=eastmoney
# 行情轮询间隔秒；免费源被限流时调大
ASHARE_POLL_INTERVAL_SECONDS=5
# 初始自选（首次建库种子；之后在页面管理）
ASHARE_WATCHLIST=600519,000001,300750,601318
# 上游请求超时
ASHARE_REQUEST_TIMEOUT_SECONDS=5
# CORS 允许来源
ASHARE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# 业务库（SQLite）；行情/因子/回测规划走 Parquet（data/parquet/）
# ASHARE_DATABASE_URL=sqlite:////absolute/path/to/data/ashare.db
# 全市场快照（市场宽度/情绪底座）：抓取间隔与 Parquet 落盘间隔（秒）
ASHARE_SNAPSHOT_POLL_INTERVAL_SECONDS=60
ASHARE_SNAPSHOT_SAVE_INTERVAL_SECONDS=300
# 日志级别
ASHARE_LOG_LEVEL=INFO

# ===== 前端（apps/web）=====
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
# NEXT_PUBLIC_WS_BASE=ws://127.0.0.1:8000

# ===== 同花顺官方金融数据服务（fuyao，https://fuyao.aicubes.cn）=====
# 官方源：行情/涨停池/炸板池/连板天梯/龙虎榜/财务三表/估值/交易日历/异动/热榜/全市场导出
# 注意：不含 L2 十档与逐笔（官方 capability-map 声明）
ASHARE_THS_API_KEY=
# ASHARE_THS_BASE_URL=https://fuyao.aicubes.cn

# ===== 写接口鉴权（B6，opt-in：留空=本地全放行；部署公网/NAS 时配置随机值）=====
# API_TOKEN=
# 前端配套（启用鉴权时设置，写请求自动携带 X-API-Token）
# NEXT_PUBLIC_API_TOKEN=

# ===== 写接口鉴权（B6，opt-in：留空=本地全放行；部署公网/NAS 时配置随机值）=====
# API_TOKEN=
# 前端配套（启用鉴权时设置，写请求自动携带 X-API-Token）
# NEXT_PUBLIC_API_TOKEN=

# ===== Phase 7 AI 模块（接入时启用；敏感值只放本地 .env，禁止提交）=====
# LLM_API_KEY=
# MARKET_DATA_API_KEY=
