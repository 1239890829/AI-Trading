# ===== 后端（ASHARE_ 前缀，见 backend/app/core/config.py）=====
# 本文件与 config.py 逐字段对齐；新增配置项时两边一起改。

# ---- 数据源 ----
# 主源 + 备源（逗号分隔）：ths | tencent | sina | eastmoney | mock；mock 只能单独使用
# 代码默认 ths（需 THS_API_KEY）；无 key 时用 tencent，免费源覆盖日常行情
ASHARE_DATA_PROVIDER=tencent
ASHARE_PROVIDER_FALLBACKS=eastmoney
ASHARE_REQUEST_TIMEOUT_SECONDS=5
# 同花顺 fuyao 官方 API Key（放 .env，勿提交）
ASHARE_THS_API_KEY=
# ASHARE_THS_BASE_URL=https://fuyao.aicubes.cn
# 题材官方成分视为有效的时长（小时），过期后懒同步（linkage-design §3）
ASHARE_THEME_MEMBERS_TTL_HOURS=168

# ---- 轮询节奏 ----
# 自选行情 WS 推送周期（秒）。1 = 秒级实时（实时方法腾讯源优先）；
# 休市自动降频 5s 保活。想要旧节奏可改回 5。
ASHARE_POLL_INTERVAL_SECONDS=1
# 连续刷新失败后数据年龄超过该秒数才标 stale 广播（瞬时失败不闪"数据过期"）
ASHARE_STALE_AFTER_SECONDS=10
# 预警引擎轮询行情间隔（秒）
ASHARE_ALERT_POLL_INTERVAL_SECONDS=5
# 全市场快照（市场宽度/情绪底座）：抓取间隔与 Parquet 落盘间隔（秒）
ASHARE_SNAPSHOT_POLL_INTERVAL_SECONDS=60
ASHARE_SNAPSHOT_SAVE_INTERVAL_SECONDS=300

# ---- 情绪阈值覆盖（P0-3；留空 = 用 engine 默认业界经验值）----
# JSON 字符串，结构与 backend/app/sentiment/engine.py 的 HEAT_BANDS / EARNING_BANDS 一致：
# 每指标为 [[上界, 得分, 标签], ...] 升序，末档上界用 null。非法配置启动即失败。
# ASHARE_SENTIMENT_HEAT_BANDS_JSON=
# ASHARE_SENTIMENT_EARNING_BANDS_JSON=

# ---- 情绪阈值历史分位校准（P0-3b）----
# 用近 N 个交易日的等分分位替代绝对经验值（实测绝对阈值下 promo_1to2 正分档 0% 命中）。
# 显式 *_BANDS_JSON 优先级更高；关掉校准即回经验值，界面 bands_source 会显示 defaults。
ASHARE_SENTIMENT_CALIBRATE=1
# 历史指标库自动增量回补（稳态每轮只拉 1-2 天 × 2 请求）
ASHARE_SENTIMENT_HISTORY_BACKFILL_ENABLED=1
ASHARE_SENTIMENT_HISTORY_LOOKBACK=250
ASHARE_SENTIMENT_HISTORY_BACKFILL_INTERVAL_SECONDS=21600

# ---- 盘前简报与盘中跟踪（选股 2.0，批次 B）----
# 交易日 08:40 自动生成盘前简报（方向排序+标的池+触发/证伪条件），落盘 data/picks/briefs/
ASHARE_PREMARKET_BRIEF_ENABLED=1
ASHARE_PREMARKET_BRIEF_HOUR=8
ASHARE_PREMARKET_BRIEF_MINUTE=40
ASHARE_PICKS_AUTOGEN_ENABLED=1
ASHARE_PICKS_AUTOGEN_HOUR=9
ASHARE_PICKS_AUTOGEN_MINUTE=26
# 盘中跟踪：交易时段内按 interval 取拍，确认/证伪判定走 intraday_rules；
# 简报未生成的日子 watcher 空转（先 POST /api/picks/morning-brief/generate）
ASHARE_PICKS_WATCHER_ENABLED=1
ASHARE_PICKS_WATCHER_INTERVAL_SECONDS=60
# 环境缓存（相位+晋级率分位）刷新间隔；全量情绪计算较重，不必每拍重算
ASHARE_PICKS_WATCHER_ENV_REFRESH_SECONDS=600
# 板块异动检测器（2026-09-13）：自主发现盘面异动题材（不依赖盘前简报登记方向），
# 数据 = 全市场快照 × 官方题材成分聚合；触发阈值在代码内（初始参数未经实证）。
# 通道沿用「飞书只留买点卡」定稿：默认不推飞书
ASHARE_BOARD_SURGE_ENABLED=1
ASHARE_BOARD_SURGE_INTERVAL_SECONDS=60
ASHARE_BOARD_SURGE_CHANNELS=in_app,log
# 龙虎榜当日归档（P2-37 二期）：交易日 17:05 起落 data/lhb/<date>.json
ASHARE_LHB_ARCHIVE_ENABLED=1
# 大单异动阈值（亿）：题材成员当日主力净流入首破该值 → 盘中提醒。
# 2026-09-10 源头收紧 0.3 → 1.0（原阈值 97% 的产出被判读层忽略）。经验初值。
ASHARE_PICKS_FLOW_SURGE_YI=1.0
# 提醒分发通道（逗号分隔：in_app/log/feishu）。2026-09-08 定稿：watcher 中间态
# （确认/证伪/大单异动）一律不推飞书——飞书只保留盘中买点卡片（ASHARE_PICKS_BUY_POINT_*）
ASHARE_PICKS_WATCHER_CHANNELS=in_app,log
# ---- AI 大脑自主进化（docs/evolution-brain-plan.md v2）----
# 交易日 15:45 自动汇总五路证据 → LLM 生成「今日进化议程」→ 按类别自动执行
# （A 参数免人工直接生效 + B 文档日报 + C 代码 patch：worktree 沙箱→回归门禁→commit）。
# 停机开关：0=只生成议程不执行
ASHARE_AGENT_AUTONOMY_ENABLED=1
ASHARE_AGENT_EVOLUTION_HOUR=15
ASHARE_AGENT_EVOLUTION_MINUTE=45
# ---- 因子 IC 月度复核（S2-11）----
# 评估产物 data/factors/eval_report.json 缺失或超 40 天时，于每月 run_day 的 17:30
# 重跑一次全历史 IC 评估（duckdb 全表扫描，走 to_thread 不卡 1s 行情节奏）。
# 自门控：产物新鲜 + 本月已尝试过（无论成败）就不会重复跑。
ASHARE_FACTOR_EVAL_ENABLED=1
ASHARE_FACTOR_EVAL_RUN_DAY=1
ASHARE_FACTOR_EVAL_HOUR=17
ASHARE_FACTOR_EVAL_MINUTE=30
# 检查周期（秒）：到点判定后 sleep 多久再查一次
ASHARE_FACTOR_EVAL_CHECK_INTERVAL_SECONDS=3600
# C 类代码执行器独立开关（最危险能力可单独关；0=议程里 C 类一律 deferred）
ASHARE_AGENT_CODE_CHANGE_ENABLED=1
# 沙箱回归门禁用的 pytest 解释器（默认 backend/.venv/bin/python，绝对路径可跨 worktree）
# ASHARE_AGENT_VENV_PYTHON=
# 成本护栏：每日进化相关 LLM 调用与自动执行任务数上限（超限议程照出但不执行）
ASHARE_AGENT_DAILY_LLM_BUDGET=8
ASHARE_AGENT_DAILY_TASK_BUDGET=3

# 盘中买点推送（2026-09-08 用户定稿，唯一保留的盘中飞书推送）：当日精选标的
# 满足全部判定（置信档≥可执行/无红线否决/闸门语义通过/现价入买入区间/未触涨停区）
# 才推飞书 interactive 卡片（版式与每日精选推送卡完全一致）；多票同拍合并一张卡，
# 每票每日至多一推。rule 通道只管 in_app/log 留痕（飞书卡片在服务内显式单发）
ASHARE_PICKS_BUY_POINT_ENABLED=1
ASHARE_PICKS_BUY_POINT_INTERVAL_SECONDS=60
ASHARE_PICKS_BUY_POINT_CHANNELS=in_app,log
# 盘后对照（批次 C）：交易日 15:35 对照当日简报方向（发酵/半发酵/证伪/无波动）
# 并回填盘中提醒的 T+1/T+3 收益；当日已 schedule 复盘过则幂等跳过
ASHARE_PICKS_REVIEW_ENABLED=1
ASHARE_PICKS_REVIEW_HOUR=15
ASHARE_PICKS_REVIEW_MINUTE=35

# ---- 执行闸门与影子持仓（P0-A/P0-B）----
# 执行闸门：9:25 竞价 gap 三态（gap=竞价涨跌幅 vs 昨收）。
# ≥ block 禁买（一字/超高开，历史胜率 12%）；observe~block 观察；≤ anomaly 异常低开复核
ASHARE_PICKS_GATE_BLOCK_GAP=9.5
ASHARE_PICKS_GATE_OBSERVE_GAP=5.0
ASHARE_PICKS_GATE_ANOMALY_GAP=-5.0
# 影子持仓：晨窗（09:26）把最新组合进 scope=shadow 独立模拟账户——
# 空仓闸门的 A/B 对照组（影子绩效=不空仓会怎样，复盘逐日量化 gate 机会成本）
ASHARE_PICKS_SHADOW_ENABLED=1
ASHARE_PICKS_SHADOW_START_MINUTE=566
ASHARE_PICKS_SHADOW_END_MINUTE=585

# ---- 相位→风格路由表（审查报告 §4.1，P1-2）----
# 六相位 → 六维权重偏移（叠加在 regime 基础权重上）。空=用默认表
# （picks/style_router.py DEFAULT_ROUTES）；非空须 JSON：
# {"发酵": {"echelon": 0.06}}，同名维度覆盖默认表；未知维度/|delta|>0.06 启动即报错
# ASHARE_PICKS_STYLE_OFFSETS_JSON=

# ---- ths 涨停原因单点哨兵（P0-B）----
# 涨停原因/题材标签 100% 依赖 ths（东财 0%，无备源）：交易时段周期探测
# reason 非空率，低于阈值/连续拉取失败 → 告警；状态见 GET /api/system/providers
ASHARE_THS_SENTINEL_ENABLED=1
ASHARE_THS_SENTINEL_INTERVAL_SECONDS=900

# ---- 东财 7x24 快讯流（hotspot-pipeline P0①）----
# 连续竞价 15s / 盘外 60s 轮询东财宏观快讯 → 指纹去重入 EventStore（事件 tab 消费）；
# 双域 failover、失败不缓存（游标不推进下轮重拉）。事件由 build_event 规则抽取。
ASHARE_FLASH_NEWS_ENABLED=1
ASHARE_FLASH_NEWS_INTERVAL_SECONDS=15
ASHARE_FLASH_NEWS_EOD_INTERVAL_SECONDS=60
# 频道（东财 fastColumn）：100=全部（含公司/资金/政策/市场）｜101=要闻｜102/103=公司
# ｜104/110=市场｜105=社会｜107/111/112/113=国际。多频道逗号分隔，跨频道按 code 去重
ASHARE_FLASH_NEWS_COLUMNS=100
# 每频道翻页数（sortEnd 游标翻页）：默认 2 页=100 条/频道，只增加覆盖不产生重复
ASHARE_FLASH_NEWS_PAGES=2

# ---- 事件采集常驻循环（R6：盘后轮次附带最近交易日涨停股范围）----
# 每 1800s 一轮（首轮延迟 45s）。测试环境必须关掉（见 tests/conftest.py）
ASHARE_EVENT_COLLECTOR_ENABLED=1

# ---- 盘中情绪监控（sentiment P2 #14）----
# 交易时段探测三类纯规则 P0 事件：高度板炸板 / 炸板率连续破 40% /
# 指数 15min 急杀 → 告警；通道逗号分隔（feishu 需先配 webhook）
ASHARE_SENTIMENT_MONITOR_ENABLED=1
ASHARE_SENTIMENT_MONITOR_INTERVAL_SECONDS=60
ASHARE_SENTIMENT_MONITOR_CHANNELS=in_app,log
# 炸板率告警阈值（占比 0~1，显式配置压过经验值；默认 0.40）
ASHARE_SENTIMENT_BREAK_RATE_THRESHOLD=0.40

# 站内通知中心：事件评分 ≥ 阈值才通知（不逐条推送；默认 60）
ASHARE_NOTIFICATIONS_NEWS_MIN_SCORE=60.0

# ---- P2-3 层1：pending 事件 LLM 辅助判定（app/events/llm_aux.py）----
# 规则引擎判不出方向的事件攒批交给 LLM 判一次，命中写 matched_by=llm_aux 的方向行。
# **默认关**：LLM 判定有真实成本，需显式打开才跑
ASHARE_EVENT_LLM_AUX_ENABLED=0
ASHARE_EVENT_LLM_AUX_MIN_BATCH=2
ASHARE_EVENT_LLM_AUX_MAX_BATCH=12
ASHARE_EVENT_LLM_AUX_AGE_MAX_H=5.0
ASHARE_EVENT_LLM_AUX_LOOP_INTERVAL=1200.0

# ---- marketdb 盘后增量同步 ----
# RPS / tech_score v3 的数据地基（DuckDB 日K 仓）：每日盘后自动增量同步
# （近 10 交易日 dump + 复权重建，子进程隔离），当日成功一次即幂等跳过。
# 默认关：每日全市场 dump 下载（几十 MB）+ ths 配额，知情后手动打开；
# 需 ASHARE_THS_API_KEY。手动兜底：python scripts/sync_marketdb.py
# ASHARE_MARKETDB_SYNC_ENABLED=0
# ASHARE_MARKETDB_SYNC_HOUR=16
# ASHARE_MARKETDB_SYNC_MINUTE=30
# ASHARE_MARKETDB_SYNC_CHECK_INTERVAL_SECONDS=300

# ---- 业务数据 ----
# 初始自选（首次建库种子；之后在页面管理）
ASHARE_WATCHLIST=600519,000001,300750,601318
# CORS 允许来源（部署到 NAS/云主机时把实际访问域名加进来，否则前端请求被拦）
ASHARE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# 业务库（SQLite）；容器内建议挂到 volume 上
# ASHARE_DATABASE_URL=sqlite:////absolute/path/to/data/ashare.db
# Parquet 快照目录（回测与市场宽度底座）
# ASHARE_PARQUET_DIR=/absolute/path/to/data/parquet

ASHARE_LOG_LEVEL=INFO

# ---- LLM 后端（复盘 LLM 分析器与新闻 LLM 摘要共用）----
# openai（默认）：HTTP 直连 /chat/completions 兼容端点，凭据配各自 *_LLM_*
# claude_cli：子进程调本机 claude 无头模式，凭据走用户 ~/.claude 配置——
# 适合只有客户端受限中转 key（如 AgentRouter，WAF 只放行官方 CLI）的场景；
# 此时 *_LLM_BASE_URL/_API_KEY 留空，只填 *_LLM_MODEL
# ASHARE_LLM_PROVIDER=openai
# ASHARE_LLM_CLI_PATH=
# 网关健康探针：定时最小调用体检，区分「额度不足」与「网关失败」（两者在系统里
# 都表现为降级到 rules，不探就分不出来）。单次约 $0.0006，默认半小时一拍；
# 设 0 关闭（仍可 GET /api/system/llm-probe?force=1 手动触发）
# ASHARE_LLM_PROBE_ENABLED=true
# ASHARE_LLM_PROBE_INTERVAL_SECONDS=1800
# 探针告警：连续失败几次才发（带冷却，防刷屏）、冷却秒数、推送通道
# ASHARE_LLM_PROBE_ALERT_AFTER=3
# ASHARE_LLM_PROBE_ALERT_COOLDOWN_SECONDS=3600
# ASHARE_LLM_PROBE_CHANNELS=in_app,log
# 助手受限工具调用：允许助手按需调只读数据工具（涨停池/龙虎榜/复盘报告等白名单）。
# 关掉后提示词不再注入工具清单，助手回到「只有注入快照、其余靠背书」的状态
# ASHARE_ASSISTANT_TOOLS_ENABLED=true

# ---- 盘后复盘 Agent ----
# 分析器：rules（默认，确定性、零成本）| llm（需配下面的 base_url + api_key）
ASHARE_REVIEW_MODEL=rules
ASHARE_REVIEW_METHODOLOGY_VERSION=v1
# 调度：北京时间几点几分触发收盘复盘
ASHARE_REVIEW_RUN_HOUR=15
ASHARE_REVIEW_RUN_MINUTE=30
ASHARE_REVIEW_SCHEDULER_ENABLED=true
ASHARE_REVIEW_CHECK_INTERVAL_SECONDS=60
# LLM 分析器（未配置时自动降级到 rules，不影响可用性）
# ASHARE_REVIEW_LLM_BASE_URL=
# ASHARE_REVIEW_LLM_API_KEY=
# ASHARE_REVIEW_LLM_MODEL=

# ---- 新闻/公告摘要 ----
# 摘要器：rules（默认，永远可用）| llm（增强层，需配下面的凭据）
# 规则层已能产出 重要度/情绪/事实摘要/关键数字，LLM 不是前置依赖
ASHARE_NEWS_MODEL=rules
# ASHARE_NEWS_LLM_BASE_URL=
# ASHARE_NEWS_LLM_API_KEY=
# ASHARE_NEWS_LLM_MODEL=

# ---- 告警推送通道：飞书（两条路二选一，都配时优先 webhook）----
# A. 群自定义机器人 webhook：在飞书群「设置 → 群机器人 → 自定义机器人」添加后复制；
# ASHARE_ALERT_FEISHU_WEBHOOK=
# 机器人开启「签名校验」时填同款密钥；未开启留空
# ASHARE_ALERT_FEISHU_SECRET=
# B. 自建应用凭据直发 P2P 私信（无需建群；2026-09-04 实测可用）：
#    APP_ID/SECRET 来自飞书开放平台「凭证与基础信息」，OPEN_ID 为接收人
#    open_id（ou_ 开头，lark-cli auth status 可查）。三件齐备且 webhook 未配时启用。
# ASHARE_FEISHU_APP_ID=
# ASHARE_FEISHU_APP_SECRET=
# ASHARE_FEISHU_NOTIFY_OPEN_ID=

# ---- 写接口鉴权（opt-in）----
# 留空 = 本地开发全放行；部署到公网/NAS 时【必须】配置随机值，
# 之后所有写请求必须带 X-API-Token 头（前端 NEXT_PUBLIC_API_TOKEN 自动携带）
# ASHARE_API_TOKEN=

# ===== 前端（apps/web）=====
# 注意：NEXT_PUBLIC_* 在构建时内联，改了要重新 build
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
# NEXT_PUBLIC_WS_BASE=ws://127.0.0.1:8000
# 启用后端写鉴权时配套设置（写请求自动携带 X-API-Token）
# NEXT_PUBLIC_API_TOKEN=
