<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  独立盘后复盘（脱离 WorkBuddy automation 独立运行）——16:30 周一~周五。

  选型依据：docs/summary/ai-evolution.md §6（launchd + claude -p 为主线）。
  时刻 16:30 是刻意的：避开 15:45 飞书「进化总结报告」（仍由 WorkBuddy automation 承担），
  本任务只产出复盘文档、不推送——推送矩阵保持「飞书每日仅一条」单点（KB-DEC-001）。

  安装：cp 到 ~/Library/LaunchAgents/ 后 launchctl load -w（本文件是模板，未 load）。
  卸载：launchctl unload ~/Library/LaunchAgents/com.ashare.review.plist
  排查：tail -f scripts/agent/logs/run.log
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ashare.review</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/hezifeng/Desktop/project/ms/ashare-ai-trader/scripts/agent/run_review.sh</string>
    </array>

    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>16</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>16</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>16</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>16</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>16</integer><key>Minute</key><integer>30</integer></dict>
    </array>

    <!-- 错过时刻（休眠/关机）时补跑一次 -->
    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/hezifeng/Desktop/project/ms/ashare-ai-trader/scripts/agent/logs/launchd.out</string>
    <key>StandardErrorPath</key>
    <string>/Users/hezifeng/Desktop/project/ms/ashare-ai-trader/scripts/agent/logs/launchd.err</string>

    <!-- 无人值守护栏：单次最长 20 分钟，超时 kill（防 agent 跑飞烧 token） -->
    <key>TimeOut</key>
    <integer>1200</integer>
</dict>
</plist>
